import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
    Scanner sc = new Scanner (System.in);
int a,b,c,ta,tb,tc,t;
a = sc.nextInt();
b = sc.nextInt();
c = sc.nextInt();
ta = a * 3;
tb = b * 1;
tc = c * 0;
t = ta + tb + tc;
System.out.println(t);

	}
}
